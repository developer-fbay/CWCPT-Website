# Copy to .env for local work. Never commit .env. In production set these in Cloudflare
# (Workers > cwcpt-website > Settings > Variables and Secrets), marking the server ones as secrets.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# n8n: the Contact form posts to /api/contact, which forwards to this webhook.
NUXT_N8N_CONTACT_WEBHOOK=
NUXT_N8N_WEBHOOK_SECRET=

# Supabase (only if needed). Service key is server only.
NUXT_SUPABASE_SERVICE_KEY=
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_ANON_KEY=
