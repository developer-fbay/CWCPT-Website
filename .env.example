# Copy to .env for local work. Never commit .env. In production set these in DigitalOcean
# (App Platform > the app > Settings > Environment Variables), with the server ones marked Encrypt.
# NUXT_PUBLIC_SITE_URL is needed at build time too (canonicals and the sitemap are written then).
# Leave unset to use https://coworkcapetown.com (never the localhost or ondigitalocean.app address)
# NUXT_PUBLIC_SITE_URL=

# n8n: the Contact form posts to /api/contact, which forwards to this webhook.
NUXT_N8N_CONTACT_WEBHOOK=
NUXT_N8N_WEBHOOK_SECRET=

# Supabase (only if needed). Service key is server only.
NUXT_SUPABASE_SERVICE_KEY=
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_ANON_KEY=
